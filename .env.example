# Database (PostgreSQL) - contoh untuk lingkungan lokal
DATABASE_URL="postgresql://bizmanage_user:YOUR_DB_PASSWORD@localhost:5434/bizmanage_db?schema=public"

# Seed dua akun PENGELOLA awal (wajib diisi sebelum menjalankan seed, JANGAN commit nilai asli)
SEED_ADMIN1_USERNAME="admin1"
SEED_ADMIN1_PASSWORD="change-me-strong-password"
SEED_ADMIN2_USERNAME="admin2"
SEED_ADMIN2_PASSWORD="change-me-strong-password"

# Opsional: secret untuk strategi sesi jika diperlukan di masa depan
# SESSION_SECRET=""